# -----------------------------------------------------------------------------
# Tukaatu Marketplace API - doorstep POD online payment (Express -> Tukaatu)
# -----------------------------------------------------------------------------
# Base URL: prefer marketplace.api_base_url (Admin Marketplaces); env is fallback.
# Auth for outbound POD request: X-Tukaatu-Key / X-Tukaatu-Secret
# Callbacks arrive at POST /api/v1/express/callback (single Express callback URL)
#   with X-Tukaatu-Event: pod_payment.ready|paid|failed and X-Tukaatu-Signature
# Express does NOT call HamroPay createSession for rider doorstep QR.
TUKAATU_API_BASE_URL=https://api.tukaatu.com
EXPRESS_TUKAATU_API_KEY=
EXPRESS_TUKAATU_API_SECRET=
TUKAATU_CALLBACK_SECRET=
# Optional. Empty secret = unsigned callbacks accepted. With a secret, a missing
# X-Tukaatu-Signature is accepted unless this is true. A wrong signature is always 401.
TUKAATU_CALLBACK_REQUIRE_SIGNATURE=false
TUKAATU_POD_PAYMENT_REQUEST_PATH=/api/v1/gateway/payments/pod-qr
TUKAATU_API_TIMEOUT=20
TUKAATU_CALLBACK_TOLERANCE=300
TUKAATU_API_VERIFY_SSL=true

# Legacy Store Manager payment-session webhook only. Legacy only. Doorstep POD uses TUKAATU_API_BASE_URL + EXPRESS_TUKAATU_API_KEY/SECRET.
# Local Docker: http://store-manager:8000 | host SM: http://host.docker.internal:8000
# STORE_MANAGER_PAYMENT_* is legacy only. Doorstep POD now uses Tukaatu (TUKAATU_* / EXPRESS_TUKAATU_*). STORE_MANAGER_PAYMENT_* is legacy webhook only.
STORE_MANAGER_PAYMENT_ENABLED=true
STORE_MANAGER_PAYMENT_BASE_URL=http://store-manager:8000
STORE_MANAGER_PAYMENT_INTEGRATION_ID=tukaatu-express
STORE_MANAGER_PAYMENT_INTEGRATION_SECRET=
STORE_MANAGER_PAYMENT_CREATE_PATH=/api/v1/integrations/tukaatu-express/pod-payment-sessions
STORE_MANAGER_PAYMENT_STATUS_PATH=/api/v1/integrations/tukaatu-express/pod-payment-sessions/{payment_session_id}
STORE_MANAGER_PAYMENT_TIMEOUT=20
STORE_MANAGER_PAYMENT_WEBHOOK_TOLERANCE=300

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


