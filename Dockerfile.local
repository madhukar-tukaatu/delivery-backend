FROM php:8.4-fpm

WORKDIR /var/www/html

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_HOME=/tmp/composer

# =========================================================
# System dependencies
# =========================================================

RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    zip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libonig-dev \
    libxml2-dev \
    default-mysql-client \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        zip \
        intl \
        bcmath \
        exif \
        pcntl \
        sockets \
        gd \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# =========================================================
# Composer
# =========================================================

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# =========================================================
# PHP configuration
# =========================================================

COPY docker/php.ini /usr/local/etc/php/conf.d/custom.ini

# =========================================================
# Local startup script
# =========================================================

COPY docker/start.local.sh /usr/local/bin/start.local.sh

RUN chmod +x /usr/local/bin/start.local.sh

# =========================================================
# Laravel directory structure
#
# These directories are also recreated by start.local.sh
# because the project is bind-mounted in docker-compose.
# =========================================================

RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/framework/testing \
    storage/logs \
    bootstrap/cache

EXPOSE 9000

ENTRYPOINT ["start.local.sh"]

CMD ["php-fpm", "-F"]